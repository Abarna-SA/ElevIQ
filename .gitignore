# ========================
# Root-level ignores
# ========================

# OS files
.DS_Store
Thumbs.db

# IDE / Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Vercel
.vercel/

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Firebase logs
firebase-debug.log
firepit-log.txt
firebase-debug.*.log

# ========================
# Node.js / Next.js (eleviq_web)
# ========================
node_modules/
.next/
out/
build/
coverage/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# ========================
# Flutter / Dart (eleviq_flutter)
# ========================
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
.flutter-plugins
.pub-cache/
.pub/
eleviq_flutter/build/
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
*.iml
*.ipr
*.iws

# Flutter generated
.packages
.plugin_symlinks/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# ========================
# Secrets & Credentials (NEVER commit)
# ========================
*.pem
*.p12
*.key
*.keystore
*.jks
key.properties
**/android/key.properties
**/android/app/*.keystore

# Google Services (contains API keys)
# NOTE: google-services.json and GoogleService-Info.plist
# are kept in repo for build convenience but are restricted via Firebase rules.
# If you want to exclude them, uncomment below:
# **/google-services.json
# **/GoogleService-Info.plist

# ========================
# Misc
# ========================
*.log
.sass-cache/
.cache/
dist/
tmp/
.firebase/

# ========================
# User Requested Ignores
# ========================
.vercel/
docs/
eleviq_backend_report.md
eleviq_frontend_report.md
pptx.ts
sdkconfig.json

# Backend Code (keep structure, ignore code)
firebase/functions/src/**/*.ts
firebase/functions/src/**/*.js
firebase/functions/lib/
eleviq_web/src/app/api/**/*.ts
eleviq_web/src/app/api/**/*.tsx
