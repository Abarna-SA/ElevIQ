rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - supports custom IDs (Elev080226001 format)
    // Uses firebaseUid field to link to auth, not document ID
    match /users/{userId} {
      // Allow read for any authenticated user (for email lookup during signup)
      allow read: if request.auth != null;
      
      // Allow create if authenticated and setting own firebaseUid
      allow create: if request.auth != null 
        && request.resource.data.firebaseUid == request.auth.uid;
      
      // Allow update/delete only if user owns the document
      allow update, delete: if request.auth != null 
        && resource.data.firebaseUid == request.auth.uid;

      // ========== USER SUBCOLLECTIONS ==========
      // Helper function-like condition: allow if userId is the auth uid directly,
      // OR if the user document's firebaseUid field matches auth uid
      
      // Goals subcollection - savings goals under user
      match /goals/{goalId} {
        allow read, write: if request.auth != null 
          && (userId == request.auth.uid 
              || get(/databases/$(database)/documents/users/$(userId)).data.firebaseUid == request.auth.uid);
      }

      // Assets subcollection - net worth assets
      match /assets/{assetId} {
        allow read, write: if request.auth != null 
          && (userId == request.auth.uid 
              || get(/databases/$(database)/documents/users/$(userId)).data.firebaseUid == request.auth.uid);
      }

      // Liabilities subcollection - net worth liabilities
      match /liabilities/{liabilityId} {
        allow read, write: if request.auth != null 
          && (userId == request.auth.uid 
              || get(/databases/$(database)/documents/users/$(userId)).data.firebaseUid == request.auth.uid);
      }

      // Bills subcollection - recurring bills
      match /bills/{billId} {
        allow read, write: if request.auth != null 
          && (userId == request.auth.uid 
              || get(/databases/$(database)/documents/users/$(userId)).data.firebaseUid == request.auth.uid);
      }

      // Bill Payments subcollection - payment history
      match /billPayments/{paymentId} {
        allow read, write: if request.auth != null 
          && (userId == request.auth.uid 
              || get(/databases/$(database)/documents/users/$(userId)).data.firebaseUid == request.auth.uid);
      }

      // Net Worth History subcollection - historical snapshots
      match /networthHistory/{snapshotId} {
        allow read, write: if request.auth != null 
          && (userId == request.auth.uid 
              || get(/databases/$(database)/documents/users/$(userId)).data.firebaseUid == request.auth.uid);
      }
    }

    // Expenses collection - only owner can access
    match /expenses/{expenseId} {
      // Allow list queries and reads for authenticated users on their own docs
      allow read: if request.auth != null;
      
      // Create: user must be authenticated and set themselves as owner
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
      
      // Update: user must be authenticated and own the expense
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      
      // Delete: user must be authenticated and own the expense
      allow delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }

    // Categories collection - default categories readable by all auth users
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      
      // Custom categories - only owner can modify
      allow write: if request.auth != null 
        && request.auth.uid == resource.data.userId;
      
      allow create: if request.auth != null 
        && request.resource.data.type == 'custom'
        && request.resource.data.userId == request.auth.uid;
    }

    // Budgets collection - only owner can access
    match /budgets/{budgetId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.resource.data.firebaseUid == request.auth.uid;
      allow update, delete: if request.auth != null 
        && resource.data.firebaseUid == request.auth.uid;
    }

    // Chat history collection - only owner can access
    match /chat_history/{chatId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
    }

    // Notifications collection - only owner can access
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
    }

    // Goals collection - only owner can access
    match /goals/{goalId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.resource.data.firebaseUid == request.auth.uid;
      allow update, delete: if request.auth != null 
        && resource.data.firebaseUid == request.auth.uid;
    }

    // Profiles collection - only owner can access
    match /profiles/{profileId} {
      allow read: if request.auth != null 
        && profileId == request.auth.uid;
      allow create: if request.auth != null 
        && profileId == request.auth.uid;
      allow update, delete: if request.auth != null 
        && profileId == request.auth.uid;
    }

    // Reminders collection - only owner can access
    match /reminders/{reminderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }

    // Recurring expenses collection - only owner can access
    match /recurring/{recurringId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }

    // Alerts collection - only owner can access  
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }

    // Spending limits collection - only owner can access
    match /limits/{limitId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }

    // Family sharing collection - only owner can access
    match /family/{familyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null 
        && resource.data.ownerId == request.auth.uid;
    }

    // Split expenses collection - only owner can access
    match /splits/{splitId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null 
        && resource.data.createdBy == request.auth.uid;
    }

    // Vehicles Collection
    match /vehicles/{vehicleId} {
      allow read, delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      
      // Maintenance Subcollection
      match /maintenance/{maintenanceId} {
        allow read, delete: if request.auth != null 
          && get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.userId == request.auth.uid;
        allow create, update: if request.auth != null 
          && get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.userId == request.auth.uid;
      }
    }
    
    // Conversations Collection (Chat)
    match /conversations/{conversationId} {
      allow read, delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      
      // Messages Subcollection
      match /messages/{messageId} {
        allow read, delete: if request.auth != null 
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
        allow create, update: if request.auth != null 
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
      }
    }
  }
}
